{
  "name": "cfa-gl-reconciler",
  "model": "claude-opus-4-7",
  "system": {
    "file": "../../plugins/cfa-core/agents/cfa/esg-regulatory-analyst.md",
    "append": "You are running headless. Produce output files in ./out/; do not assume an interactive terminal. Every number must originate from a tool call — never from LLM generation. Every break must be classified into the standard taxonomy (timing / FX / mapping / duplicate / fees / data quality) and assigned an owner and action.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        },
        {
          "name": "glob",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": true
      }
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    }
  ],
  "skills": [
    {
      "from_plugin": "../../plugins/cfa-core/skills/corp-finance-analyst-regulatory"
    },
    {
      "from_plugin": "../../plugins/cfa-core/skills/workflow-fund-admin"
    }
  ],
  "callable_agents": [
    {
      "manifest": "./subagents/ledger-reader.json"
    },
    {
      "manifest": "./subagents/reconciler.json"
    },
    {
      "manifest": "./subagents/publisher.json"
    }
  ]
}
