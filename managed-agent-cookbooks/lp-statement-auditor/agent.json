{
  "name": "cfa-lp-statement-auditor",
  "model": "claude-opus-4-7",
  "system": {
    "file": "../../../.claude/agents/cfa/private-markets-analyst.md",
    "append": "You are running headless. Produce output files in ./out/; do not assume an interactive terminal. Every number must originate from a tool call — never from LLM generation. Reconcile every line of the LP statement; report variance flags and never silently accept GP-reported figures.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        },
        {
          "name": "glob",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": true
      }
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    }
  ],
  "skills": [
    {
      "from_skill": "corp-finance-analyst-regulatory"
    },
    {
      "from_skill": "workflow-fund-admin"
    }
  ],
  "callable_agents": [
    {
      "manifest": "./subagents/statement-reader.json"
    },
    {
      "manifest": "./subagents/auditor.json"
    },
    {
      "manifest": "./subagents/reporter.json"
    }
  ]
}
