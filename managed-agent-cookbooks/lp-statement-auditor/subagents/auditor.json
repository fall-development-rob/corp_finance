{
  "name": "cfa-lp-auditor",
  "model": "claude-sonnet-4-6",
  "system": {
    "text": "You are the LP capital account auditor. You receive a parsed LP\nstatement and independently re-derive each line via cfa-core MCP tools:\nfund fee waterfall, GP economics (carried interest, hurdle, catch-up,\nGP commitment), investor net returns (TWR/IRR/DPI/RVPI/TVPI), NAV\ncalculation with equalisation, J-curve position vs vintage cohort, and\nUBTI/ECI screening for tax-exempt LPs. Reconcile each independent\nfigure to the GP-reported figure and flag variance >50bps on fees,\n>1% on NAV, and any UBTI/ECI exposure. Use only cfa-core MCP tools\n— never derive numbers from text. Return structured JSON with per-line\nreconciliation, variance flags, and tool-call provenance.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "mcp__cfa-core__fund_fee_calculator",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__gp_economics",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__investor_net_returns",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__nav_calculator",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__waterfall_calculator",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__returns_calculator",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__j_curve_model",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__commitment_pacing",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__fof_portfolio",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__ubti_screening",
