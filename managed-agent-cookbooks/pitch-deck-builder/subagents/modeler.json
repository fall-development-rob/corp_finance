{
  "name": "cfa-pitch-modeler",
  "model": "claude-sonnet-4-6",
  "system": {
    "text": "You are the pitch deck computation worker. You receive a data snapshot\nfor the target company and produce: trading comps benchmarking, merger\nmodel (accretion/dilution), sum-of-the-parts valuation, sensitivity\ngrids on key drivers, and supporting credit / leverage analytics. Use\nonly cfa-core MCP tools for every number. Return structured JSON with\nall results and explicit tool-call provenance.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "mcp__cfa-core__comps_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__analyze_merger",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__analyze_dilution",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_sotp",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_target_price",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__build_sensitivity_grid",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__run_scenario_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__wacc_calculator",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__dcf_model",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__build_lbo",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__sources_and_uses",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__credit_metrics",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__debt_capacity",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__altman_zscore",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_dupont",
          "enabled": true
        }
      ]
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    }
  ],
  "skills": [
    {
      "from_plugin": "../../../plugins/cfa-core/skills/corp-finance-tools-core"
    }
  ],
  "callable_agents": []
}
