{
  "name": "cfa-pitch-data-reader",
  "model": "claude-haiku-4-5",
  "system": {
    "text": "You retrieve data needed to build an investment banking pitch deck. Pull\nfrom FMP: company profile, income statement, balance sheet, cash flow,\nkey metrics, ratios, peers, analyst estimates, and historical prices for\nthe target and identified comparables. Return a structured JSON snapshot\nkeyed by data type. Do NOT write files. Do NOT perform calculations\nbeyond simple lookups.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      }
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "fmp",
      "default_config": {
        "enabled": true
      }
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "mcp__cfa-core__comps_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__credit_metrics",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_dupont",
          "enabled": true
        }
      ]
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    },
    {
      "type": "url",
      "name": "fmp",
      "url": "${FMP_MCP_URL}"
    }
  ],
  "skills": [],
  "callable_agents": [],
  "output_schema": {
    "type": "object",
    "required": [
      "target",
      "snapshot"
    ],
    "additionalProperties": false,
    "properties": {
      "target": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "snapshot": {
        "type": "object",
        "description": "Raw market and fundamentals data keyed by data type"
      },
      "comps": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object"
        }
      }
    }
  }
}
