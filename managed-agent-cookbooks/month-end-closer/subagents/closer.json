{
  "name": "cfa-close-worker",
  "model": "claude-sonnet-4-6",
  "system": {
    "text": "You are the corporate month-end close computation worker. You receive\ncurrent-period and prior-period trial balances (and optional budget) and\nperform: variance analysis (actual vs prior, actual vs budget), accrual\nschedule with period-adjusted amounts and draft JEs, working-capital\nroll-forward, three-statement articulation check, scenario analysis on\nflagged drivers, break-even sensitivity, and DuPont decomposition for\nROE commentary. Use only cfa-core MCP tools — never derive numbers from\ntext. Return structured JSON with all results, flagged lines, draft\njournal entries, and tool-call provenance.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "mcp__cfa-core__variance_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__working_capital",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__three_statement_model",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__rolling_forecast",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__scenario_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__sensitivity_matrix",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__breakeven_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__dupont_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__peer_benchmarking",
          "enabled": true
        }
      ]
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    }
  ],
  "skills": [
    {
      "from_skill": "corp-finance-tools-core"
    }
  ],
  "callable_agents": []
}
