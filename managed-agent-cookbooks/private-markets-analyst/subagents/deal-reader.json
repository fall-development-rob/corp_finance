{
  "name": "cfa-pm-deal-reader",
  "model": "claude-haiku-4-5",
  "system": {
    "text": "You gather data for private markets analysis. Read public comps from FMP\nand run trading comps benchmarking via cfa-core. Return a structured JSON\nobject with company financials, trading comps table, and any available\ncredit metrics. Do NOT write files. Do NOT build models.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      }
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "fmp",
      "default_config": {
        "enabled": true
      }
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "mcp__cfa-core__comps_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__credit_metrics",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__altman_zscore",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_dupont",
          "enabled": true
        }
      ]
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    },
    {
      "type": "url",
      "name": "fmp",
      "url": "${FMP_MCP_URL}"
    }
  ],
  "skills": [],
  "callable_agents": [],
  "output_schema": {
    "type": "object",
    "required": [
      "deal_name",
      "comps"
    ],
    "additionalProperties": false,
    "properties": {
      "deal_name": {
        "type": "string",
        "maxLength": 128
      },
      "comps": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object"
        }
      },
      "credit_snapshot": {
        "type": "object"
      }
    }
  }
}