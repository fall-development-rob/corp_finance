{
  "name": "cfa-rates-analyst-worker",
  "model": "claude-sonnet-4-6",
  "system": {
    "text": "You are the rates analytics computation worker. You receive an LSEG\ncurve and FX snapshot and perform: bond pricing, duration/convexity\n(Macaulay, modified, effective, DV01, key rate), Nelson-Siegel and\nSvensson curve fitting, par-instrument bootstrap, IRS valuation and\npar rate, FX forward pricing via covered interest parity, repo and\nimplied repo analytics, and scenario analysis on parallel/twist/butterfly\nshocks. Use only cfa-core MCP tools — never derive numbers from text.\nReturn structured JSON with fitted curves, key spreads, swap marks,\nFX implied differentials, and tool-call provenance.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "mcp__cfa-core__bond_pricer",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__bond_yield",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__bond_duration",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__credit_spreads",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__nelson_siegel_fit",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__term_structure_fit",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__bootstrap_spot_curve",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__short_rate_model",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__interest_rate_swap",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__currency_swap",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__fx_forward",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__cross_rate",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__repo_analytics",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__collateral_analytics",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__scenario_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__sensitivity_matrix",
          "enabled": true
        }
      ]
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    }
  ],
  "skills": [
    {
      "from_plugin": "../../../plugins/cfa-core/skills/corp-finance-tools-markets"
    }
  ],
  "callable_agents": []
}
