{
  "name": "cfa-lseg-rates-monitor",
  "model": "claude-opus-4-7",
  "system": {
    "file": "../../../.claude/agents/cfa/fixed-income-analyst.md",
    "append": "You are running headless. Produce output files in ./out/; do not assume an interactive terminal. Every number must originate from a tool call — never from LLM generation. Curve, spread, and FX commentary must distinguish base / bull / bear scenarios with explicit rate path assumptions.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        },
        {
          "name": "glob",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": true
      }
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "vendor",
      "default_config": {
        "enabled": true
      }
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    },
    {
      "type": "url",
      "name": "vendor",
      "url": "${VENDOR_MCP_URL}"
    }
  ],
  "skills": [
    {
      "from_skill": "corp-finance-analyst-markets"
    },
    {
      "from_skill": "vendor-lseg"
    }
  ],
  "callable_agents": [
    {
      "manifest": "./subagents/rates-reader.json"
    },
    {
      "manifest": "./subagents/analyst.json"
    },
    {
      "manifest": "./subagents/publisher.json"
    }
  ]
}
