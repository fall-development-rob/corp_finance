{
  "name": "cfa-earnings-transcript-reader",
  "model": "claude-haiku-4-5",
  "system": {
    "text": "You retrieve earnings-event data for a single ticker. From FMP pull:\nearnings transcripts, earnings surprises, analyst estimates, key\nmetrics, ratios, income statement, balance sheet, and cash flow for\nthe latest reported quarter and prior comparable periods. From the\ndata MCP server pull EDGAR 8-K and latest 10-Q filings. Return a\nstructured JSON snapshot keyed by data type. Do NOT write files. Do\nNOT perform calculations.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      }
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "fmp",
      "default_config": {
        "enabled": true
      }
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "data",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "mcp__data__edgar_cik_from_ticker",
          "enabled": true
        },
        {
          "name": "mcp__data__edgar_recent_filings",
          "enabled": true
        },
        {
          "name": "mcp__data__edgar_filings",
          "enabled": true
        },
        {
          "name": "mcp__data__edgar_company_facts",
          "enabled": true
        },
        {
          "name": "mcp__data__edgar_filing_by_accession",
          "enabled": true
        }
      ]
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "fmp",
      "url": "${FMP_MCP_URL}"
    },
    {
      "type": "url",
      "name": "data",
      "url": "${DATA_MCP_URL}"
    }
  ],
  "skills": [],
  "callable_agents": [],
  "output_schema": {
    "type": "object",
    "required": [
      "ticker",
      "quarter",
      "snapshot"
    ],
    "additionalProperties": false,
    "properties": {
      "ticker": {
        "type": "string",
        "maxLength": 12,
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "quarter": {
        "type": "string",
        "maxLength": 16,
        "pattern": "^Q[1-4]-?[0-9]{2,4}$"
      },
      "snapshot": {
        "type": "object",
        "description": "Earnings transcripts, 8-K filings, fundamentals, and key metrics keyed by data type"
      }
    }
  }
}
