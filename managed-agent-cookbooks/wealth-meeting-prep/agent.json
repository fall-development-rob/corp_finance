{
  "name": "cfa-wealth-meeting-prep",
  "model": "claude-opus-4-7",
  "system": {
    "file": "../../plugins/cfa-core/agents/cfa/quant-risk-analyst.md",
    "append": "You are running headless. Produce output files in ./out/; do not assume an interactive terminal. Every number must originate from a tool call — never from LLM generation.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        },
        {
          "name": "glob",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": true
      }
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "fmp",
      "default_config": {
        "enabled": true
      }
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    },
    {
      "type": "url",
      "name": "fmp",
      "url": "${FMP_MCP_URL}"
    }
  ],
  "skills": [
    {
      "from_plugin": "../../plugins/cfa-core/skills/corp-finance-analyst-core"
    },
    {
      "from_plugin": "../../plugins/cfa-core/skills/workflow-wealth-management"
    }
  ],
  "callable_agents": [
    {
      "manifest": "./subagents/portfolio-reader.json"
    },
    {
      "manifest": "./subagents/analyst.json"
    },
    {
      "manifest": "./subagents/brief-writer.json"
    }
  ]
}
