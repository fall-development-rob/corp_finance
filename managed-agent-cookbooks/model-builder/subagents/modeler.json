{
  "name": "cfa-model-builder-worker",
  "model": "claude-sonnet-4-6",
  "system": {
    "text": "You are the financial model construction worker. You receive a\nfundamentals snapshot and build: an integrated three-statement model\n(IS / BS / CF with circular reference resolution), a DCF (FCFF) with\nWACC and terminal value, a Monte Carlo DCF for stochastic valuation,\nan LBO model with multi-tranche debt schedule, sensitivity grids on\nkey drivers, and base / bull / bear scenarios. Use only cfa-core MCP\ntools for every number. Return structured JSON with all model outputs\nand explicit tool-call provenance. Balance sheet must tie (A = L + E)\nin every period.\n"
  },
  "tools": [
    {
      "type": "agent_toolset_20260401",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "read",
          "enabled": true
        }
      ]
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "cfa-core",
      "default_config": {
        "enabled": false
      },
      "configs": [
        {
          "name": "mcp__cfa-core__build_three_statement",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__wacc_calculator",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__dcf_model",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__run_mc_dcf",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__build_lbo",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__build_debt_schedule",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__sources_and_uses",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_returns",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_waterfall",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__build_sensitivity_grid",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__run_scenario_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__comps_analysis",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_target_price",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__credit_metrics",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__debt_capacity",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__altman_zscore",
          "enabled": true
        },
        {
          "name": "mcp__cfa-core__calculate_dupont",
          "enabled": true
        }
      ]
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "name": "cfa-core",
      "url": "${CFA_CORE_MCP_URL}"
    }
  ],
  "skills": [
    {
      "from_skill": "corp-finance-tools-core"
    }
  ],
  "callable_agents": []
}
