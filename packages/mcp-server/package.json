{
  "name": "@robotixai/corp-finance-mcp",
  "version": "1.0.0",
  "description": "Institutional-grade corporate finance calculations as MCP tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/fall-development-rob/corp_finance.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "corp-finance-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schemas:gen:office": "cd ../.. && cargo test -p corp-finance-core --features schema_gen,office --test export_office_schemas && cd packages/mcp-server && node scripts/gen-office-schemas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@robotixai/corp-finance-bindings": "file:../bindings",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "json-schema-to-zod": "^2.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
